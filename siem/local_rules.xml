<!-- Custom rules for the lab firewall (Wazuh 4.14.8).
     Append to /var/ossec/etc/rules/local_rules.xml, then run:
       sudo /var/ossec/bin/wazuh-analysisd -t
     and restart the manager only if the check is clean. -->

<group name="local,firewall,lab,">
  <rule id="100100" level="6">
    <if_sid>4100</if_sid>
    <match>LAB-INTERNAL-DENY</match>
    <description>Lab firewall: connection toward the internal network was blocked and logged</description>
    <group>firewall_block,</group>
  </rule>
</group>

<group name="local,firewall,lab,">
  <rule id="100101" level="10" frequency="5" timeframe="60">
    <if_matched_sid>100100</if_matched_sid>
    <same_srcip />
    <description>Lab firewall: repeated blocked attempts toward the internal network from the same source</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>firewall_block,recon,</group>
  </rule>
</group>

<group name="local,firewall,lab,">
  <rule id="100102" level="12" frequency="5" timeframe="60">
    <if_matched_sid>100100</if_matched_sid>
    <same_srcip />
    <different_dstport />
    <description>Lab firewall: possible port scan, one source blocked on several different ports toward the internal network</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>firewall_block,recon,port_scan,</group>
  </rule>
</group>
